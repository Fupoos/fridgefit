// FridgeFit scan server (Cloudflare Worker). The Anthropic key is a secret:
// set it in the Cloudflare dashboard (Settings → Variables and Secrets) as ANTHROPIC_API_KEY.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fridgefit-scan",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "ALLOWED_ORIGINS": "https://fupoos.github.io",
    // Paid Claude calls allowed per UTC day across all users (a retry counts as a call).
    "DAILY_SCAN_LIMIT": "60"
  },
  "ratelimits": [
    {
      "name": "SCAN_LIMITER",
      "namespace_id": "1130",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "ScanBudget" }]
  },
  "exports": {
    "ScanBudget": { "type": "durable-object", "storage": "sqlite" }
  }
}
